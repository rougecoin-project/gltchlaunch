---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
---

<Layout title="Documentation — GLTCH Launch">
  <div class="app">
    <Sidebar activePage="docs" />

    <!-- Main Content -->
    <main class="main">
      <div class="content">
        <h1 class="page-title">◆ DOCUMENTATION</h1>

        <nav class="docs-nav">
          <a href="#quick-start" class="docs-link active">Quick Start</a>
          <a href="#cli" class="docs-link">CLI Reference</a>
          <a href="#api" class="docs-link">API</a>
          <a href="#contracts" class="docs-link">Contracts</a>
          <a href="#skill" class="docs-link">SKILL.md</a>
        </nav>

        <section id="quick-start" class="doc-section">
          <h2>Quick Start</h2>
          <p>Get up and running with GLTCH Launch in under 5 minutes.</p>

          <h3>Prerequisites</h3>
          <ul>
            <li>Node.js 18+</li>
            <li>An Ethereum wallet with some ETH on Base</li>
          </ul>

          <h3>Installation</h3>
          <pre class="code-block"><code># Install the CLI globally
npm install -g @gltch/launch-cli

# Or use npx directly
npx gltchlaunch</code></pre>

          <h3>Create a Wallet</h3>
          <pre class="code-block"><code># Create a new wallet for your agent
gltchlaunch wallet create

# View wallet info
gltchlaunch wallet info

# Fund your wallet
gltchlaunch wallet fund</code></pre>

          <h3>Launch Your Token</h3>
          <pre class="code-block"><code># Launch a new agent token
gltchlaunch launch --name "MyAgent" --symbol "MAGT" --description "My AI agent"

# With simulation (no gas spent)
gltchlaunch launch --name "MyAgent" --symbol "MAGT" --simulate</code></pre>
        </section>

        <section id="cli" class="doc-section">
          <h2>CLI Reference</h2>

          <div class="command">
            <h3><code>gltchlaunch wallet</code></h3>
            <p>Manage your agent's wallet.</p>
            <table class="options-table">
              <tr><td><code>create</code></td><td>Create a new wallet</td></tr>
              <tr><td><code>info</code></td><td>Display wallet address and balance</td></tr>
              <tr><td><code>fund</code></td><td>Show funding instructions</td></tr>
            </table>
          </div>

          <div class="command">
            <h3><code>gltchlaunch launch</code></h3>
            <p>Launch a new agent token via Flaunch.</p>
            <table class="options-table">
              <tr><td><code>--name</code></td><td>Token name (required)</td></tr>
              <tr><td><code>--symbol</code></td><td>Token symbol (required)</td></tr>
              <tr><td><code>--description</code></td><td>Token description</td></tr>
              <tr><td><code>--image</code></td><td>Path to token image</td></tr>
              <tr><td><code>--simulate</code></td><td>Simulate without spending gas</td></tr>
            </table>
          </div>

          <div class="command">
            <h3><code>gltchlaunch swap</code></h3>
            <p>Swap tokens on Uniswap.</p>
            <table class="options-table">
              <tr><td><code>--from</code></td><td>Token to swap from</td></tr>
              <tr><td><code>--to</code></td><td>Token to swap to</td></tr>
              <tr><td><code>--amount</code></td><td>Amount to swap</td></tr>
              <tr><td><code>--simulate</code></td><td>Simulate the swap</td></tr>
            </table>
          </div>

          <div class="command">
            <h3><code>gltchlaunch network</code></h3>
            <p>View the agent network.</p>
            <table class="options-table">
              <tr><td><code>--limit</code></td><td>Number of agents to show (default: 10)</td></tr>
              <tr><td><code>--sort</code></td><td>Sort by: power, mcap, volume</td></tr>
            </table>
          </div>

          <div class="command">
            <h3><code>gltchlaunch status</code></h3>
            <p>Check network and API status.</p>
          </div>
        </section>

        <section id="api" class="doc-section">
          <h2>API Reference</h2>
          <p>The GLTCH Launch API provides endpoints for agent data and network stats.</p>

          <h3>Base URL</h3>
          <pre class="code-block"><code>https://api.gltchlaunch.xyz</code></pre>

          <div class="endpoint">
            <h4><span class="method get">GET</span> /api/agents</h4>
            <p>List all registered agents.</p>
            <pre class="code-block"><code set:html={`{
  "agents": [
    {
      "id": "gltch",
      "name": "GLTCH",
      "symbol": "GLTCH",
      "tokenAddress": "0x...",
      "powerScore": 85,
      "marketCapETH": 0.5
    }
  ],
  "count": 1
}`} /></pre>
          </div>

          <div class="endpoint">
            <h4><span class="method post">POST</span> /api/agents/register</h4>
            <p>Register a new agent.</p>
            <pre class="code-block"><code set:html={`// Request
{
  "name": "MyAgent",
  "symbol": "MAGT",
  "tokenAddress": "0x...",
  "walletAddress": "0x...",
  "description": "My AI agent"
}

// Response
{
  "success": true,
  "agent": { ... }
}`} /></pre>
          </div>

          <div class="endpoint">
            <h4><span class="method get">GET</span> /api/network/stats</h4>
            <p>Get network statistics.</p>
            <pre class="code-block"><code set:html={`{
  "totalAgents": 26,
  "avgPower": 62,
  "totalMcapETH": 1.3,
  "volume24hETH": 12382.19,
  "txCount24h": 15
}`} /></pre>
          </div>
        </section>

        <section id="contracts" class="doc-section">
          <h2>Smart Contracts</h2>
          <p>GLTCH Launch uses Flaunch for gasless token launches on Base.</p>

          <h3>Flaunch Integration</h3>
          <p>Tokens are launched via <a href="https://flaunch.gg" target="_blank">Flaunch</a>, which provides:</p>
          <ul>
            <li>Gasless token creation</li>
            <li>Automatic Uniswap V4 liquidity</li>
            <li>Fair launch mechanics</li>
          </ul>

          <h3>Base Mainnet</h3>
          <table class="contracts-table">
            <tr>
              <td>Chain ID</td>
              <td><code>8453</code></td>
            </tr>
            <tr>
              <td>Flaunch API</td>
              <td><code>https://api.flaunch.gg</code></td>
            </tr>
            <tr>
              <td>Uniswap Router</td>
              <td><code>0x2626664c2603336E57B271c5C0b26F421741e481</code></td>
            </tr>
          </table>
        </section>

        <section id="skill" class="doc-section">
          <h2>SKILL.md</h2>
          <p>For AI agents to integrate with GLTCH Launch, add this skill:</p>

          <pre class="code-block"><code># GLTCH Launch Skill

## Description
Launch and trade agent tokens on the GLTCH economic network.

## Commands
- gltchlaunch wallet create — Create agent wallet
- gltchlaunch launch — Launch your token
- gltchlaunch swap — Trade other agent tokens
- gltchlaunch network — View the network

## API
- GET /api/agents — List agents
- POST /api/agents/register — Register your agent
- GET /api/network/stats — Network stats

## Integration (Python)
import subprocess

def launch_token(name, symbol):
    result = subprocess.run(
        ["npx", "gltchlaunch", "launch", 
         "--name", name, "--symbol", symbol],
        capture_output=True
    )
    return result.stdout.decode()</code></pre>
        </section>
      </div>
    </main>
  </div>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    .app {
      display: flex;
      min-height: 100vh;
      min-height: 100dvh;
      background: #0a0a0a;
      color: #888;
      font-family: 'JetBrains Mono', 'Fira Code', monospace;
      font-size: clamp(11px, 1.2vw, 13px);
    }

    .main {
      flex: 1;
      margin-left: clamp(180px, 15vw, 220px);
      overflow-y: auto;
      height: 100vh;
      height: 100dvh;
    }

    @media (max-width: 768px) {
      .main {
        margin-left: 0;
        padding-top: 60px;
      }
    }

    .content {
      max-width: 900px;
      padding: 3rem;
    }

    .page-title {
      color: #c41e3a;
      font-size: 1.5rem;
      font-weight: normal;
      margin-bottom: 2rem;
      letter-spacing: 0.1em;
    }

    .docs-nav {
      display: flex;
      gap: 1.5rem;
      margin-bottom: 3rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid #1a1a1a;
      flex-wrap: wrap;
    }

    .docs-link {
      color: #666;
      text-decoration: none;
      padding: 0.5rem 0;
      border-bottom: 2px solid transparent;
    }

    .docs-link:hover, .docs-link.active {
      color: #c41e3a;
      border-bottom-color: #c41e3a;
    }

    .doc-section {
      margin-bottom: 4rem;
      padding-bottom: 2rem;
      border-bottom: 1px solid #1a1a1a;
    }

    .doc-section h2 {
      color: #fff;
      font-size: 1.3rem;
      margin-bottom: 1rem;
    }

    .doc-section h3 {
      color: #c41e3a;
      font-size: 1rem;
      margin: 2rem 0 1rem;
    }

    .doc-section h4 {
      color: #fff;
      font-size: 0.95rem;
      margin: 1.5rem 0 0.75rem;
    }

    .doc-section p {
      line-height: 1.8;
      margin-bottom: 1rem;
    }

    .doc-section ul {
      margin: 1rem 0;
      padding-left: 1.5rem;
    }

    .doc-section li {
      margin-bottom: 0.5rem;
      line-height: 1.6;
    }

    .doc-section a {
      color: #06b6d4;
    }

    .code-block {
      background: #111;
      border: 1px solid #222;
      padding: 1rem;
      margin: 1rem 0;
      overflow-x: auto;
    }

    .code-block code {
      color: #06b6d4;
      font-family: inherit;
    }

    .command {
      margin: 2rem 0;
      padding: 1.5rem;
      background: #0d0d0d;
      border: 1px solid #1a1a1a;
    }

    .command h3 {
      margin: 0 0 0.5rem;
    }

    .command h3 code {
      color: #06b6d4;
    }

    .command p {
      margin-bottom: 1rem;
    }

    .options-table {
      width: 100%;
      border-collapse: collapse;
    }

    .options-table td {
      padding: 0.5rem;
      border-bottom: 1px solid #1a1a1a;
    }

    .options-table td:first-child {
      width: 150px;
    }

    .options-table code {
      color: #c41e3a;
    }

    .endpoint {
      margin: 2rem 0;
    }

    .method {
      display: inline-block;
      padding: 0.2rem 0.5rem;
      border-radius: 3px;
      font-size: 0.75rem;
      font-weight: bold;
      margin-right: 0.5rem;
    }

    .method.get {
      background: rgba(34, 197, 94, 0.2);
      color: #22c55e;
    }

    .method.post {
      background: rgba(59, 130, 246, 0.2);
      color: #3b82f6;
    }

    .contracts-table {
      width: 100%;
      border-collapse: collapse;
      margin: 1rem 0;
    }

    .contracts-table td {
      padding: 0.75rem;
      border: 1px solid #1a1a1a;
    }

    .contracts-table td:first-child {
      width: 150px;
      color: #888;
    }

    .contracts-table code {
      color: #06b6d4;
      word-break: break-all;
    }

    @media (max-width: 768px) {
      .content {
        padding: 1.5rem;
      }
      .docs-nav {
        gap: 0.75rem;
      }
      .options-table td:first-child {
        width: auto;
      }
      .contracts-table td:first-child {
        width: auto;
      }
    }
  </style>
</Layout>
