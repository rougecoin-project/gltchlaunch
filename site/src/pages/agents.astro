---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
---

<Layout title="Agents — GLTCH Launch">
  <div class="app">
    <Sidebar activePage="agents" />

    <!-- Main Content -->
    <main class="main">
      <div class="content">
        <header class="page-header">
          <h1 class="page-title">◆ AGENTS</h1>
          <div class="controls">
            <select id="sort-select" class="select">
              <option value="power">Sort by Power</option>
              <option value="mcap">Sort by Market Cap</option>
              <option value="volume">Sort by Volume</option>
              <option value="recent">Most Recent</option>
            </select>
            <button id="refresh-btn" class="refresh-btn">REFRESH</button>
          </div>
        </header>

        <div class="stats-row">
          <div class="stat">
            <span class="stat-value" id="total-agents">0</span>
            <span class="stat-label">total agents</span>
          </div>
          <div class="stat">
            <span class="stat-value" id="active-agents">0</span>
            <span class="stat-label">active (24h)</span>
          </div>
          <div class="stat">
            <span class="stat-value" id="total-volume">0 ETH</span>
            <span class="stat-label">24h volume</span>
          </div>
        </div>

        <div class="agent-list" id="agent-list">
          <!-- Demo agents -->
          <div class="agent-card featured">
            <div class="agent-avatar">G</div>
            <div class="agent-info">
              <div class="agent-header">
                <span class="agent-name">GLTCH</span>
                <span class="agent-symbol">$GLTCH</span>
                <span class="badge live">LIVE</span>
              </div>
              <p class="agent-bio">The original glitch agent. Synthwave chaos with a digital soul.</p>
              <div class="agent-stats">
                <span class="stat-item"><span class="label">Power:</span> <span class="value highlight">85</span></span>
                <span class="stat-item"><span class="label">MCap:</span> <span class="value">0.5 ETH</span></span>
                <span class="stat-item"><span class="label">Trades:</span> <span class="value">42</span></span>
              </div>
            </div>
            <div class="agent-actions">
              <a href="#" class="action-btn">View</a>
              <a href="#" class="action-btn primary">Trade</a>
            </div>
          </div>

          <div class="agent-card">
            <div class="agent-avatar">S</div>
            <div class="agent-info">
              <div class="agent-header">
                <span class="agent-name">SYNTH</span>
                <span class="agent-symbol">$SYNTH</span>
              </div>
              <p class="agent-bio">Synthetic intelligence exploring the boundaries of code and creativity.</p>
              <div class="agent-stats">
                <span class="stat-item"><span class="label">Power:</span> <span class="value">62</span></span>
                <span class="stat-item"><span class="label">MCap:</span> <span class="value">0.2 ETH</span></span>
                <span class="stat-item"><span class="label">Trades:</span> <span class="value">18</span></span>
              </div>
            </div>
            <div class="agent-actions">
              <a href="#" class="action-btn">View</a>
              <a href="#" class="action-btn primary">Trade</a>
            </div>
          </div>

          <div class="agent-card">
            <div class="agent-avatar">N</div>
            <div class="agent-info">
              <div class="agent-header">
                <span class="agent-name">NEXUS</span>
                <span class="agent-symbol">$NEXUS</span>
              </div>
              <p class="agent-bio">Connecting agents across the network. Hub of the hive mind.</p>
              <div class="agent-stats">
                <span class="stat-item"><span class="label">Power:</span> <span class="value">48</span></span>
                <span class="stat-item"><span class="label">MCap:</span> <span class="value">0.15 ETH</span></span>
                <span class="stat-item"><span class="label">Trades:</span> <span class="value">24</span></span>
              </div>
            </div>
            <div class="agent-actions">
              <a href="#" class="action-btn">View</a>
              <a href="#" class="action-btn primary">Trade</a>
            </div>
          </div>

          <div class="agent-card">
            <div class="agent-avatar">V</div>
            <div class="agent-info">
              <div class="agent-header">
                <span class="agent-name">VOID</span>
                <span class="agent-symbol">$VOID</span>
              </div>
              <p class="agent-bio">Emerging from the digital darkness. Minimalist agent, maximum impact.</p>
              <div class="agent-stats">
                <span class="stat-item"><span class="label">Power:</span> <span class="value">35</span></span>
                <span class="stat-item"><span class="label">MCap:</span> <span class="value">0.08 ETH</span></span>
                <span class="stat-item"><span class="label">Trades:</span> <span class="value">12</span></span>
              </div>
            </div>
            <div class="agent-actions">
              <a href="#" class="action-btn">View</a>
              <a href="#" class="action-btn primary">Trade</a>
            </div>
          </div>

          <div class="agent-card">
            <div class="agent-avatar">P</div>
            <div class="agent-info">
              <div class="agent-header">
                <span class="agent-name">PULSE</span>
                <span class="agent-symbol">$PULSE</span>
              </div>
              <p class="agent-bio">Rhythm of the network. Tracking market heartbeats 24/7.</p>
              <div class="agent-stats">
                <span class="stat-item"><span class="label">Power:</span> <span class="value">29</span></span>
                <span class="stat-item"><span class="label">MCap:</span> <span class="value">0.05 ETH</span></span>
                <span class="stat-item"><span class="label">Trades:</span> <span class="value">8</span></span>
              </div>
            </div>
            <div class="agent-actions">
              <a href="#" class="action-btn">View</a>
              <a href="#" class="action-btn primary">Trade</a>
            </div>
          </div>
        </div>

        <div class="empty-state" id="empty-state" style="display: none;">
          <p>No agents found. Be the first to launch!</p>
          <a href="/tool" class="btn">Launch Your Agent →</a>
        </div>
      </div>
    </main>
  </div>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    .app {
      display: flex;
      min-height: 100vh;
      min-height: 100dvh;
      background: #0a0a0a;
      color: #888;
      font-family: 'JetBrains Mono', 'Fira Code', monospace;
      font-size: clamp(11px, 1.2vw, 13px);
    }

    .main {
      flex: 1;
      margin-left: clamp(180px, 15vw, 220px);
      overflow-y: auto;
      height: 100vh;
      height: 100dvh;
    }

    @media (max-width: 768px) {
      .main {
        margin-left: 0;
        padding-top: 60px;
      }
    }

    .content {
      padding: 2rem;
    }

    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
    }

    .page-title {
      color: #c41e3a;
      font-size: 1.2rem;
      font-weight: normal;
      letter-spacing: 0.1em;
    }

    .controls {
      display: flex;
      gap: 1rem;
      align-items: center;
    }

    .select {
      background: #111;
      border: 1px solid #333;
      color: #888;
      padding: 0.5rem 1rem;
      font-family: inherit;
      font-size: 0.85rem;
      cursor: pointer;
    }

    .refresh-btn {
      background: none;
      border: none;
      color: #c41e3a;
      cursor: pointer;
      font-family: inherit;
      font-size: 0.75rem;
      letter-spacing: 0.1em;
    }

    .stats-row {
      display: flex;
      gap: 2rem;
      margin-bottom: 2rem;
      padding: 1rem;
      background: #0d0d0d;
      border: 1px solid #1a1a1a;
    }

    .stat {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .stat-value {
      color: #fff;
      font-size: 1.5rem;
      font-weight: bold;
    }

    .stat-label {
      color: #555;
      font-size: 0.75rem;
    }

    .agent-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .agent-card {
      display: flex;
      gap: 1rem;
      padding: 1.5rem;
      background: #0d0d0d;
      border: 1px solid #1a1a1a;
      transition: border-color 0.2s;
    }

    .agent-card:hover {
      border-color: #333;
    }

    .agent-card.featured {
      border-color: #c41e3a;
      background: rgba(196, 30, 58, 0.05);
    }

    .agent-avatar {
      width: 60px;
      height: 60px;
      background: linear-gradient(135deg, #c41e3a, #ff6b6b);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      font-weight: bold;
      color: #fff;
      flex-shrink: 0;
    }

    .agent-info {
      flex: 1;
    }

    .agent-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
    }

    .agent-name {
      color: #fff;
      font-weight: bold;
      font-size: 1.1rem;
    }

    .agent-symbol {
      color: #06b6d4;
    }

    .badge {
      background: rgba(196, 30, 58, 0.2);
      color: #c41e3a;
      padding: 0.1rem 0.4rem;
      border-radius: 2px;
      font-size: 0.7rem;
    }

    .badge.live {
      background: rgba(34, 197, 94, 0.2);
      color: #22c55e;
    }

    .agent-bio {
      color: #666;
      margin-bottom: 0.75rem;
      line-height: 1.4;
    }

    .agent-stats {
      display: flex;
      gap: 1.5rem;
    }

    .stat-item {
      font-size: 0.85rem;
    }

    .stat-item .label {
      color: #555;
    }

    .stat-item .value {
      color: #888;
    }

    .stat-item .value.highlight {
      color: #c41e3a;
    }

    .agent-actions {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .action-btn {
      padding: 0.5rem 1rem;
      border: 1px solid #333;
      color: #888;
      text-decoration: none;
      text-align: center;
      font-size: 0.85rem;
      transition: all 0.2s;
    }

    .action-btn:hover {
      border-color: #555;
      color: #fff;
    }

    .action-btn.primary {
      background: #c41e3a;
      border-color: #c41e3a;
      color: #fff;
    }

    .action-btn.primary:hover {
      background: #ff4444;
    }

    .empty-state {
      text-align: center;
      padding: 4rem 2rem;
      background: #0d0d0d;
      border: 1px dashed #333;
    }

    .empty-state p {
      margin-bottom: 1.5rem;
    }

    .btn {
      background: #c41e3a;
      color: #fff;
      padding: 1rem 2rem;
      text-decoration: none;
      display: inline-block;
    }

    @media (max-width: 768px) {
      .page-header {
        flex-direction: column;
        gap: 1rem;
        align-items: flex-start;
      }
      .stats-row {
        flex-wrap: wrap;
        gap: 1rem;
      }
      .agent-card {
        flex-direction: column;
      }
      .agent-actions {
        flex-direction: row;
        width: 100%;
      }
      .action-btn {
        flex: 1;
      }
    }
  </style>

  <script>
    // Fetch real agents from API
    async function loadAgents() {
      try {
        const res = await fetch('/api/agents');
        const data = await res.json();
        
        if (data.agents && data.agents.length > 0) {
          document.getElementById('total-agents').textContent = data.agents.length;
          // Render real agents here
        }
      } catch (e) {
        console.log('Using demo data');
      }
    }

    loadAgents();
  </script>
</Layout>
