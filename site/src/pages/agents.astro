---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
---

<Layout title="Agents — GLTCH Launch">
  <div class="app">
    <Sidebar activePage="agents" />

    <!-- Main Content -->
    <main class="main">
      <div class="content">
        <header class="page-header">
          <h1 class="page-title">◆ AGENTS</h1>
          <div class="controls">
            <select id="sort-select" class="select">
              <option value="power">Sort by Power</option>
              <option value="mcap">Sort by Market Cap</option>
              <option value="volume">Sort by Volume</option>
              <option value="recent">Most Recent</option>
            </select>
            <button id="refresh-btn" class="refresh-btn">REFRESH</button>
          </div>
        </header>

        <div class="stats-row">
          <div class="stat">
            <span class="stat-value" id="total-agents">5</span>
            <span class="stat-label">total agents</span>
          </div>
          <div class="stat">
            <span class="stat-value" id="active-agents">3</span>
            <span class="stat-label">active (24h)</span>
          </div>
          <div class="stat">
            <span class="stat-value" id="total-volume">0.98 ETH</span>
            <span class="stat-label">24h volume</span>
          </div>
        </div>

        <div class="agent-list" id="agent-list">
          <!-- Loading state -->
          <div id="loading-state" class="loading-state">Loading agents from Flaunch...</div>
          
          <!-- Empty state -->
          <div id="empty-state" class="empty-state" style="display: none;">
            <p>No agents found. Be the first to launch!</p>
            <a href="/tool" class="btn">Launch Your Agent →</a>
          </div>
        </div>

        <div class="cta-box">
          <p>Want to join the network?</p>
          <a href="/tool" class="btn">Launch Your Agent →</a>
        </div>
      </div>
    </main>
  </div>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    .app {
      display: flex;
      min-height: 100vh;
      min-height: 100dvh;
      background: #0a0a0a;
      color: #888;
      font-family: 'JetBrains Mono', 'Fira Code', monospace;
      font-size: clamp(11px, 1.2vw, 13px);
    }

    .main {
      flex: 1;
      margin-left: clamp(180px, 15vw, 220px);
      overflow-y: auto;
      height: 100vh;
      height: 100dvh;
    }

    @media (max-width: 768px) {
      .main {
        margin-left: 0;
        padding-top: 60px;
      }
    }

    .content {
      padding: 2rem;
    }

    .page-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
    }

    .page-title {
      color: #c41e3a;
      font-size: 1.2rem;
      font-weight: normal;
      letter-spacing: 0.1em;
    }

    .controls {
      display: flex;
      gap: 1rem;
      align-items: center;
    }

    .select {
      background: #111;
      border: 1px solid #333;
      color: #888;
      padding: 0.5rem 1rem;
      font-family: inherit;
      font-size: 0.85rem;
      cursor: pointer;
    }

    .refresh-btn {
      background: none;
      border: none;
      color: #c41e3a;
      cursor: pointer;
      font-family: inherit;
      font-size: 0.75rem;
      letter-spacing: 0.1em;
    }

    .stats-row {
      display: flex;
      gap: 2rem;
      margin-bottom: 2rem;
      padding: 1rem;
      background: #0d0d0d;
      border: 1px solid #1a1a1a;
    }

    .stat {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .stat-value {
      color: #fff;
      font-size: 1.5rem;
      font-weight: bold;
    }

    .stat-label {
      color: #555;
      font-size: 0.75rem;
    }

    .agent-list {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .agent-card {
      display: flex;
      gap: 1rem;
      padding: 1.5rem;
      background: #0d0d0d;
      border: 1px solid #1a1a1a;
      transition: border-color 0.2s;
    }

    .agent-card:hover {
      border-color: #333;
    }

    .agent-card.featured {
      border-color: #c41e3a;
      background: rgba(196, 30, 58, 0.05);
    }

    .agent-avatar {
      width: 60px;
      height: 60px;
      min-width: 60px;
      background: linear-gradient(135deg, #c41e3a, #ff6b6b);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      font-weight: bold;
      color: #fff;
      overflow: hidden;
      flex-shrink: 0;
    }

    .agent-info {
      flex: 1;
    }

    .agent-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 0.5rem;
    }

    .agent-name {
      color: #fff;
      font-weight: bold;
      font-size: 1.1rem;
    }

    .agent-symbol {
      color: #06b6d4;
    }

    .badge {
      background: rgba(196, 30, 58, 0.2);
      color: #c41e3a;
      padding: 0.1rem 0.4rem;
      border-radius: 2px;
      font-size: 0.7rem;
    }

    .badge.live {
      background: rgba(34, 197, 94, 0.2);
      color: #22c55e;
    }

    .price-change {
      font-size: 0.8rem;
      padding: 0.1rem 0.4rem;
      border-radius: 2px;
    }

    .price-change.positive {
      background: rgba(34, 197, 94, 0.2);
      color: #22c55e;
    }

    .price-change.negative {
      background: rgba(239, 68, 68, 0.2);
      color: #ef4444;
    }

    .agent-bio {
      color: #666;
      margin-bottom: 0.75rem;
      line-height: 1.4;
    }

    .agent-stats {
      display: flex;
      gap: 1.5rem;
    }

    .stat-item {
      font-size: 0.85rem;
    }

    .stat-item .label {
      color: #555;
    }

    .stat-item .value {
      color: #888;
    }

    .stat-item .value.highlight {
      color: #c41e3a;
    }

    .agent-actions {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .action-btn {
      padding: 0.5rem 1rem;
      border: 1px solid #333;
      color: #888;
      text-decoration: none;
      text-align: center;
      font-size: 0.85rem;
      transition: all 0.2s;
    }

    .action-btn:hover {
      border-color: #555;
      color: #fff;
    }

    .action-btn.primary {
      background: #c41e3a;
      border-color: #c41e3a;
      color: #fff;
    }

    .action-btn.primary:hover {
      background: #ff4444;
    }

    .cta-box {
      text-align: center;
      padding: 2rem;
      margin-top: 2rem;
      background: #0d0d0d;
      border: 1px solid #1a1a1a;
    }

    .cta-box p {
      margin-bottom: 1rem;
      color: #666;
    }

    .btn {
      background: #c41e3a;
      color: #fff;
      padding: 0.75rem 1.5rem;
      text-decoration: none;
      display: inline-block;
      transition: background 0.2s;
    }

    .btn:hover {
      background: #ff4444;
    }

    .loading-state,
    .empty-state {
      text-align: center;
      padding: 3rem;
      color: #666;
      background: #0d0d0d;
      border: 1px solid #1a1a1a;
    }

    .empty-state .btn {
      margin-top: 1rem;
    }

    @media (max-width: 768px) {
      .page-header {
        flex-direction: column;
        gap: 1rem;
        align-items: flex-start;
      }
      .stats-row {
        flex-wrap: wrap;
        gap: 1rem;
      }
      .agent-card {
        flex-direction: column;
      }
      .agent-actions {
        flex-direction: row;
        width: 100%;
      }
      .action-btn {
        flex: 1;
      }
    }
  </style>

  <script>
    // Known GLTCH Launch agents (launched via Flaunch)
    const KNOWN_AGENTS = [
      {
        tokenAddress: '0xaafa6b01c66559dd314aa2373b97a95626e63013',
        name: 'GLTCH',
        symbol: 'GLTCH',
        description: 'The original glitch agent. Synthwave chaos with a digital soul.',
        creator: '0x977D4EF2EB80B911Ee8e08868fA7C5bFaAF904a5',
        flaunchUrl: 'https://flaunch.gg/base/coin/0xaafa6b01c66559dd314aa2373b97a95626e63013',
        image: 'https://ipfs.io/ipfs/QmP15XkodVwhUSBnRP5x52uVD63412igpu1yGvk929XuZ5',
        featured: true
      }
    ];

    // Flaunch API base
    const FLAUNCH_API = 'https://api.flaunch.gg';

    // Render an agent card
    function renderAgentCard(agent, priceData = null) {
      const card = document.createElement('div');
      card.className = 'agent-card' + (agent.featured ? ' featured' : '');
      
      const initial = agent.symbol[0].toUpperCase();
      const imageUrl = priceData?.imageUrl || agent.image;
      const avatarContent = imageUrl 
        ? `<img src="${imageUrl}" alt="${agent.name}" style="width: 100%; height: 100%; border-radius: 8px; object-fit: cover;" onerror="this.style.display='none'; this.parentElement.textContent='${initial}';" />`
        : initial;
      
      // Format market cap
      let mcap = 'Loading...';
      if (priceData?.marketCapUSD) {
        if (priceData.marketCapUSD >= 1000000) {
          mcap = `$${(priceData.marketCapUSD / 1000000).toFixed(2)}M`;
        } else if (priceData.marketCapUSD >= 1000) {
          mcap = `$${(priceData.marketCapUSD / 1000).toFixed(1)}K`;
        } else {
          mcap = `$${priceData.marketCapUSD.toFixed(0)}`;
        }
      }
      
      // Format volume
      let volume = '--';
      if (priceData?.volume24h) {
        if (priceData.volume24h >= 1000) {
          volume = `$${(priceData.volume24h / 1000).toFixed(1)}K`;
        } else {
          volume = `$${priceData.volume24h.toFixed(0)}`;
        }
      }
      
      const txCount = priceData?.txCount || 0;
      const priceChange = priceData?.priceChange24h || 0;
      const changeClass = priceChange >= 0 ? 'positive' : 'negative';
      const changeSign = priceChange >= 0 ? '+' : '';
      
      card.innerHTML = `
        <div class="agent-avatar">${avatarContent}</div>
        <div class="agent-info">
          <div class="agent-header">
            <span class="agent-name">${agent.name}</span>
            <span class="agent-symbol">$${agent.symbol}</span>
            ${agent.featured ? '<span class="badge live">LIVE</span>' : ''}
            <span class="price-change ${changeClass}">${changeSign}${priceChange.toFixed(1)}%</span>
          </div>
          <p class="agent-bio">${agent.description || ''}</p>
          <div class="agent-stats">
            <span class="stat-item"><span class="label">MCap:</span> <span class="value">${mcap}</span></span>
            <span class="stat-item"><span class="label">24h Vol:</span> <span class="value">${volume}</span></span>
            <span class="stat-item"><span class="label">Txns:</span> <span class="value">${txCount}</span></span>
          </div>
        </div>
        <div class="agent-actions">
          <a href="https://basescan.org/token/${agent.tokenAddress}" target="_blank" class="action-btn">BaseScan</a>
          <a href="${agent.flaunchUrl || `https://flaunch.gg/base/coin/${agent.tokenAddress}`}" target="_blank" class="action-btn primary">Trade on Flaunch</a>
        </div>
      `;
      
      return card;
    }

    // Fetch price data from DexScreener (more reliable for real-time data)
    async function fetchPriceData(tokenAddress) {
      try {
        const res = await fetch(`https://api.dexscreener.com/latest/dex/tokens/${tokenAddress}`);
        if (res.ok) {
          const data = await res.json();
          if (data.pairs && data.pairs.length > 0) {
            const pair = data.pairs[0];
            
            // Get image URL
            let imageUrl = null;
            if (pair.info && pair.info.imageUrl) {
              imageUrl = pair.info.imageUrl;
            } else if (pair.baseToken && pair.baseToken.logoURI) {
              imageUrl = pair.baseToken.logoURI;
            }
            
            return {
              marketCapUSD: pair.marketCap || pair.fdv || 0,
              priceUSD: pair.priceUsd || 0,
              priceETH: pair.priceNative || 0,
              volume24h: pair.volume?.h24 || 0,
              txCount: (pair.txns?.h24?.buys || 0) + (pair.txns?.h24?.sells || 0),
              priceChange24h: pair.priceChange?.h24 || 0,
              imageUrl: imageUrl
            };
          }
        }
      } catch (e) {
        console.log('Could not fetch price data:', e);
      }
      return null;
    }

    // Load and display all agents
    async function loadAgents() {
      const listEl = document.getElementById('agent-list');
      const loadingEl = document.getElementById('loading-state');
      const emptyEl = document.getElementById('empty-state');
      
      try {
        // Clear loading state
        loadingEl.style.display = 'none';
        
        if (KNOWN_AGENTS.length === 0) {
          emptyEl.style.display = 'block';
          return;
        }
        
        // Update stats
        document.getElementById('total-agents').textContent = KNOWN_AGENTS.length;
        document.getElementById('active-agents').textContent = KNOWN_AGENTS.length;
        
        // Render each agent
        for (const agent of KNOWN_AGENTS) {
          const priceData = await fetchPriceData(agent.tokenAddress);
          const card = renderAgentCard(agent, priceData);
          listEl.appendChild(card);
        }
        
      } catch (e) {
        console.error('Error loading agents:', e);
        loadingEl.textContent = 'Error loading agents. Please refresh.';
      }
    }

    // Refresh button handler
    document.getElementById('refresh-btn').addEventListener('click', () => {
      const listEl = document.getElementById('agent-list');
      // Keep only loading and empty states
      const children = Array.from(listEl.children);
      children.forEach(child => {
        if (!child.id) child.remove();
      });
      document.getElementById('loading-state').style.display = 'block';
      loadAgents();
    });

    loadAgents();
  </script>
</Layout>
