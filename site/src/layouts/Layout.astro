---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <style>
      :root {
        --gltch-purple: #9333ea;
        --gltch-cyan: #06b6d4;
        --gltch-magenta: #ec4899;
        --gltch-dark: #0a0a0a;
      }
      
      body {
        background: var(--gltch-dark);
        color: #e5e5e5;
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        margin: 0;
        min-height: 100vh;
      }

      /* Synthwave grid background */
      body::before {
        content: '';
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        height: 40vh;
        background: 
          linear-gradient(transparent 0%, rgba(6, 182, 212, 0.1) 100%),
          repeating-linear-gradient(
            90deg,
            transparent,
            transparent 60px,
            rgba(6, 182, 212, 0.3) 60px,
            rgba(6, 182, 212, 0.3) 61px
          ),
          repeating-linear-gradient(
            0deg,
            transparent,
            transparent 60px,
            rgba(6, 182, 212, 0.3) 60px,
            rgba(6, 182, 212, 0.3) 61px
          );
        transform: perspective(500px) rotateX(60deg);
        transform-origin: bottom;
        pointer-events: none;
        z-index: -1;
        animation: grid-scroll 20s linear infinite;
      }

      @keyframes grid-scroll {
        0% { background-position: 0 0; }
        100% { background-position: 0 60px; }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
